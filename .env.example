# ---- server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (the stellarsafe-web URL). Use * only for local dev.
CORS_ORIGINS=http://localhost:3001
# Set to true behind a reverse proxy / load balancer so client IPs are correct for rate limiting.
TRUST_PROXY=false

# ---- database
DATABASE_URL=postgres://stellarsafe:stellarsafe@localhost:5432/stellarsafe
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---- stellar
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Contracts are unaudited: mainnet is refused unless ALLOW_MAINNET=true.
ALLOW_MAINNET=false
# Optional: only accept treasury contracts built from these WASM hashes (hex, comma-separated).
TRUSTED_WASM_HASHES=

# ---- auth
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CHALLENGE_TTL_SECONDS=300
# Optional SEP-10 (transaction) sign-in. Generate a dedicated key; never reuse a funded account.
SEP10_SIGNING_SECRET=

# ---- secrets at rest (webhook signing secrets). Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ---- limits & ops
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
# If set, /metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=

# ---- workers (indexer + notifications). Prefer running `node dist/worker.js` separately.
RUN_WORKERS=false
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_WINDOW_LEDGERS=2000
INDEXER_PAGE_LIMIT=500
INDEXER_MAX_LAG_LEDGERS=120
NOTIFY_MAX_ATTEMPTS=8
NOTIFY_TIMEOUT_MS=5000
NOTIFY_DISABLE_AFTER_FAILURES=20
NOTIFY_ALLOW_PRIVATE_TARGETS=false
